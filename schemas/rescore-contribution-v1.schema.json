{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rescore.org/schemas/contribution-v1.json",
  "title": "ReScore Community Contribution",
  "type": "object",
  "required": ["protocol_version", "contribution_id", "verification", "rights", "consent", "blobs"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "contribution_id": {"type": "string", "format": "uuid"},
    "verification": {"enum": ["human-reviewed", "human-transcribed"]},
    "rights": {
      "type": "object",
      "required": ["redistributable", "source_license", "annotation_license"],
      "properties": {
        "redistributable": {"const": true},
        "source_license": {"type": "string", "minLength": 1},
        "annotation_license": {"type": "string", "minLength": 1}
      }
    },
    "consent": {
      "type": "object",
      "required": ["share_for_training", "confirmed_at"],
      "properties": {"share_for_training": {"const": true}, "confirmed_at": {"type": "string", "format": "date-time"}}
    },
    "blobs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["role", "sha256", "bytes"],
        "properties": {
          "role": {"enum": ["image", "target", "prediction", "metadata"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 26214400}
        }
      }
    }
  },
  "additionalProperties": true
}
