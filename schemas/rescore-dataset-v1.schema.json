{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rescore.org/schemas/dataset-v1.json",
  "title": "ReScore Training Dataset",
  "description": "Pairs score images with verified symbolic ground truth and explicit provenance.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset",
    "created_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "default_annotation_license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "default_annotation_license": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "visibility",
        "include_in_public_training",
        "source",
        "ground_truth",
        "alignment",
        "rights",
        "split_group",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "include_in_public_training": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "required": [
            "composer",
            "work",
            "writer_or_copyist",
            "type",
            "images"
          ],
          "properties": {
            "composer": {
              "type": "string"
            },
            "work": {
              "type": "string",
              "minLength": 1
            },
            "writer_or_copyist": {
              "type": "string"
            },
            "type": {
              "enum": [
                "printed",
                "handwritten",
                "mixed"
              ]
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/file"
                  },
                  {
                    "type": "object",
                    "required": [
                      "page",
                      "width",
                      "height",
                      "original_name"
                    ],
                    "properties": {
                      "page": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "original_name": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "ground_truth": {
          "type": "object",
          "required": [
            "musicxml",
            "source_score",
            "measure_range",
            "verification",
            "score_summary"
          ],
          "properties": {
            "musicxml": {
              "$ref": "#/$defs/file"
            },
            "source_score": {
              "$ref": "#/$defs/file"
            },
            "measure_range": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "verification": {
              "enum": [
                "human-transcribed",
                "human-reviewed",
                "partially-reviewed",
                "machine-generated"
              ]
            },
            "score_summary": {
              "type": "object"
            }
          }
        },
        "alignment": {
          "type": "object",
          "required": [
            "status",
            "image_pages",
            "score_measures"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "inferred",
                "unassigned"
              ]
            },
            "image_pages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "score_measures": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "review_status": {
              "enum": [
                "machine-proposed",
                "human-reviewed"
              ]
            },
            "page_measure_counts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "measure_region_count": {
              "type": "integer",
              "minimum": 1
            },
            "regions_file": {
              "$ref": "#/$defs/file"
            },
            "review_html": {
              "$ref": "#/$defs/file"
            },
            "preview_images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "staff_review_status": {
              "enum": [
                "machine-proposed",
                "human-reviewed"
              ]
            },
            "staff_profile": {
              "type": "string",
              "minLength": 1
            },
            "staff_region_count": {
              "type": "integer",
              "minimum": 1
            },
            "staff_cell_count": {
              "type": "integer",
              "minimum": 1
            },
            "staff_regions_file": {
              "$ref": "#/$defs/file"
            },
            "staff_review_html": {
              "$ref": "#/$defs/file"
            },
            "staff_preview_images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "review_log": {
              "$ref": "#/$defs/file"
            }
          }
        },
        "training": {
          "type": "object",
          "required": [
            "schema_version",
            "tokenizer",
            "sample_count",
            "eligible_sample_count",
            "review_required_count",
            "index",
            "summary",
            "updated_at"
          ],
          "properties": {
            "schema_version": {
              "type": "string"
            },
            "tokenizer": {
              "type": "string"
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "eligible_sample_count": {
              "type": "integer",
              "minimum": 0
            },
            "review_required_count": {
              "type": "integer",
              "minimum": 0
            },
            "index": {
              "$ref": "#/$defs/file"
            },
            "summary": {
              "$ref": "#/$defs/file"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "stale": {
              "type": "boolean"
            },
            "stale_reason": {
              "type": "string"
            },
            "stale_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "rights": {
          "type": "object",
          "required": [
            "status",
            "source_license",
            "annotation_license",
            "redistributable"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "source_license": {
              "type": "string"
            },
            "annotation_license": {
              "type": "string",
              "minLength": 1
            },
            "redistributable": {
              "type": "boolean"
            }
          }
        },
        "split_group": {
          "$ref": "#/$defs/slug"
        },
        "notes": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "private"
              }
            }
          },
          "then": {
            "properties": {
              "include_in_public_training": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "public"
              }
            }
          },
          "then": {
            "properties": {
              "rights": {
                "properties": {
                  "redistributable": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
